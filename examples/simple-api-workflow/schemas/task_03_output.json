{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task_03_output",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to project root"
          },
          "content": {
            "type": "string",
            "description": "File content"
          }
        },
        "required": ["path", "content"]
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false
}
