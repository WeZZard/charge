{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "charge-state",
  "title": "Charge Workflow State",
  "description": "Tracks the execution state of a Charge workflow",

  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "Reference to the workflow this state belongs to"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed"],
      "description": "Current workflow status"
    },
    "current_task": {
      "type": ["string", "null"],
      "description": "ID of the currently executing task, or null if not running"
    },
    "completed_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of successfully completed tasks"
    },
    "failed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "error": { "type": "string" },
          "retry_count": { "type": "integer" },
          "failed_at": { "type": "string", "format": "date-time" }
        },
        "required": ["task_id", "error"]
      },
      "description": "Tasks that failed execution"
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of task_id to result file path"
    },
    "started_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When workflow execution started"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When workflow execution completed"
    },
    "error": {
      "type": ["string", "null"],
      "description": "Global error message if workflow failed"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for tracking",
      "properties": {
        "total_tokens_used": { "type": "integer" },
        "execution_time_ms": { "type": "integer" },
        "retry_count": { "type": "integer" }
      }
    }
  },

  "required": ["workflow_id", "status", "completed_tasks", "failed_tasks", "results"]
}
